# Qwen (Alibaba Cloud DashScope, OpenAI-compatible mode) — powers the agent reasoning.
# Without it the dashboard falls back to the built-in local agent team, so it still works offline.
QWEN_API_KEY=sk-your-dashscope-key
# Client-visible alias, kept for parity with the spec. Prefer QWEN_API_KEY (server-only).
NEXT_PUBLIC_QWEN_API_KEY=

# International endpoint by default. Mainland China: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# Optional: enables the CoinMarketCap step of the market-data fallback chain.
CMC_API_KEY=
